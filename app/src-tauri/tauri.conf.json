{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fiskesim",
  "version": "1.0.0",
  "identifier": "no.rdrugis.fiskesim",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [
      { "label": "main", "title": "Fiskesim", "width": 1280, "height": 860, "minWidth": 480, "minHeight": 520, "dragDropEnabled": false }
